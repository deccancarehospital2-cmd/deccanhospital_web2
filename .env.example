# Firebase Client Configuration (Public Web Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudinary Client Configuration (Unsigned Browser Uploads)
# NOTE: Cloudinary API Secret must NEVER be added to frontend client code.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Server-Side Firebase Admin Configuration (Vercel Serverless / Backend ONLY)
# NEVER prefix server secrets with VITE_ to prevent leaking to browser bundles!
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

